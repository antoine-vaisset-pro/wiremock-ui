{
  "name": "wiremock-ui",
  "version": "1.0.0",
  "scripts": {
    "ng": "ng",
    "prestart": "node generate-config.js",
    "start": "ng serve --proxy-config proxy.conf.js",
    "start:local": "WIREMOCK_BACKEND=http://localhost:8080 npm start",
    "prebuild": "node generate-config.js",
    "build": "ng build --configuration production",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false",
    "lint": "ng lint && stylelint \"src/**/*.scss\"",
    "lint:ts": "ng lint",
    "lint:styles": "stylelint \"src/**/*.scss\"",
    "lint:fix": "ng lint --fix && stylelint \"src/**/*.scss\" --fix"
  },
  "license": "Apache-2.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@angular/animations": "^22.2.3",
    "@angular/common": "^22.2.3",
    "@angular/compiler": "^22.2.3",
    "@angular/core": "^22.2.3",
    "@angular/forms": "^22.2.3",
    "@angular/localize": "^22.2.3",
    "@angular/platform-browser": "^22.2.3",
    "@angular/platform-browser-dynamic": "^22.2.3",
    "@angular/router": "^22.2.3",
    "@fortawesome/fontawesome-free": "^7.2.0",
    "@ng-bootstrap/ng-bootstrap": "^21.0.0",
    "@popperjs/core": "^2.11.8",
    "bootstrap": "^5.3.8",
    "chart.js": "4.6.1",
    "file-saver": "^2.0.5",
    "js-yaml": "^4.1.1",
    "jszip": "^3.10.1",
    "rxjs": "~7.8.1",
    "tslib": "^2.6.2",
    "zone.js": "~0.16.1"
  },
  "devDependencies": {
    "@angular-eslint/builder": "^22.6.0",
    "@angular-eslint/eslint-plugin": "^22.6.0",
    "@angular-eslint/eslint-plugin-template": "^22.6.0",
    "@angular-eslint/schematics": "^22.6.0",
    "@angular-eslint/template-parser": "^22.6.0",
    "@angular/build": "^22.2.3",
    "@angular/cli": "^22.2.3",
    "@angular/compiler-cli": "^22.2.3",
    "@eslint/js": "^10.0.1",
    "@types/file-saver": "^2.0.7",
    "@types/jasmine": "~6.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/jszip": "^3.4.1",
    "angular-eslint": "^22.6.0",
    "dotenv": "^17.3.1",
    "eslint": "^10.0.3",
    "istanbul-lib-instrument": "^6.0.3",
    "jasmine-core": "~6.1.0",
    "karma": "~6.4.3",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.1",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.2.0",
    "sass": "^1.98.0",
    "stylelint": "^17.4.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
